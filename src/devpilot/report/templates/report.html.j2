<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>DevPilot Report — {{ facts.repo }}</title>
  <style>
    /* light and dark mode via @media (prefers-color-scheme: dark) */
    :root { --bg: #fff; --fg: #1f2328; --surface: #f7f8fa; --border: #e5e7eb; --accent: #3b82d4; }
    @media (prefers-color-scheme: dark) {
      :root { --bg: #0d1117; --fg: #c9d1d9; --surface: #161b22; --border: #30363d; --accent: #58a6ff; }
    }
    body { font-family: -apple-system,"Segoe UI",system-ui,sans-serif; background:var(--bg); color:var(--fg); max-width:900px; margin:0 auto; padding:2rem; line-height:1.6; }
    h1, h2, h3 { margin-top: 2rem; }
    .cards { display: flex; gap: 1rem; flex-wrap: wrap; margin: 1rem 0; }
    .card { background: var(--surface); border: 1px solid var(--border); border-radius: 8px; padding: 1rem 1.5rem; min-width: 140px; }
    .card .num { font-size: 2rem; font-weight: 700; color: var(--accent); }
    .card .label { font-size: 0.85rem; color: #666; }
    table { border-collapse: collapse; width: 100%; margin: 1rem 0; }
    th, td { border: 1px solid var(--border); padding: 0.5rem 0.75rem; text-align: left; }
    th { background: var(--surface); }
    .high { color: #cf222e; font-weight: 600; }
    .medium { color: #9a6700; }
    .low { color: #1a7f37; }
    code { background: var(--surface); padding: 0.1rem 0.3rem; border-radius: 3px; font-size: 0.9em; }
    pre { background: var(--surface); border: 1px solid var(--border); border-radius: 6px; padding: 1rem; overflow-x: auto; }
    footer { margin-top: 3rem; padding-top: 1rem; border-top: 1px solid var(--border); text-align: center; font-size: 0.75rem; color: #666; }
  </style>
</head>
<body>
  <h1>🧭 DevPilot Onboarding Report</h1>
  <p>Repository: <strong>{{ facts.repo }}</strong> &nbsp;|&nbsp; Scanned: {{ report_generated_at }}</p>

  <!-- SECTION 1: Summary Cards -->
  <h2>Summary</h2>
  <div class="cards">
    <div class="card"><div class="num">{{ facts.languages | length }}</div><div class="label">Languages</div></div>
    <div class="card"><div class="num">{{ findings | length }}</div><div class="label">Drift Findings</div></div>
    <div class="card"><div class="num">{{ setup_steps | length }}</div><div class="label">Setup Steps Passed</div></div>
    <div class="card"><div class="num">{{ facts.env_vars | length }}</div><div class="label">Env Vars</div></div>
    <div class="card"><div class="num">{{ facts.todos | length }}</div><div class="label">TODOs</div></div>
  </div>
  {% if facts.languages %}
  <table>
    <tr><th>Language</th><th>Files</th><th>LOC</th></tr>
    {% for lang in facts.languages %}<tr><td>{{ lang.name }}</td><td>{{ lang.files }}</td><td>{{ lang.loc }}</td></tr>{% endfor %}
  </table>
  {% endif %}

  <!-- SECTION 2: Architecture Diagram -->
  <h2>Architecture</h2>
  <pre class="mermaid">{{ mermaid_diagram }}</pre>
  <script type="module">import mermaid from 'https://cdn.jsdelivr.net/npm/mermaid@10/dist/mermaid.esm.min.mjs'; mermaid.initialize({startOnLoad:true});</script>

  <!-- SECTION 3: Setup Guide -->
  <h2>Setup Guide</h2>
  {% if setup_steps %}
  <p>Commands below all passed verification:</p>
  <ol>
    {% for step in setup_steps %}<li><code>{{ step.command }}</code> <em>({{ "%.1f"|format(step.duration_s) }}s)</em></li>{% endfor %}
  </ol>
  {% else %}
  <p><em>No verified setup steps available. Run <code>devpilot verify</code> first.</em></p>
  {% endif %}

  <!-- SECTION 4: Drift Findings -->
  <h2>Doc-Drift Findings</h2>
  {% if findings %}
  <table>
    <tr><th>ID</th><th>Severity</th><th>Message</th><th>Evidence</th></tr>
    {% for f in findings %}
    <tr>
      <td>{{ f.id }}</td>
      <td class="{{ f.severity }}">{{ f.severity }}</td>
      <td>{{ f.message }}</td>
      <td>{% for e in f.evidence %}<code>{{ e }}</code><br>{% endfor %}</td>
    </tr>
    {% endfor %}
  </table>
  {% else %}
  <p>✓ No drift findings.</p>
  {% endif %}

  <!-- SECTION 5: Owners Map -->
  <h2>Owners</h2>
  {% if facts.owners %}
  <table>
    <tr><th>Path</th><th>Owners</th><th>Source</th></tr>
    {% for o in facts.owners %}<tr><td><code>{{ o.path }}</code></td><td>{{ o.owners | join(", ") }}</td><td>{{ o.source }}</td></tr>{% endfor %}
  </table>
  {% else %}
  <p><em>No owner information found. Add a CODEOWNERS file to enable this.</em></p>
  {% endif %}

  <!-- SECTION 6: First 5 Tasks -->
  <h2>Suggested First Tasks</h2>
  {% if first_tasks %}
  <ol>
    {% for t in first_tasks %}
    <li><code>{{ t.file }}:{{ t.line }}</code> — {{ t.text }}</li>
    {% endfor %}
  </ol>
  {% else %}
  <p><em>No TODO/FIXME candidates found. Check hotspots for entry points.</em></p>
  {% endif %}

  <footer>Generated by DevPilot &nbsp;|&nbsp; <a href="ONBOARDING.md">ONBOARDING.md</a></footer>
</body>
</html>
